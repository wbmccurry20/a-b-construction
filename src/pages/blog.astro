---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Construction Blog | A&B Construction Tips & Insights";
const pageDescription = "Expert construction tips, home improvement ideas, and industry insights from A&B Construction. Get expert advice on building and renovation in Western NC.";

const categories = ['All', 'New Construction', 'Renovation Tips', 'Green Building', 'Design Trends', 'Project Spotlights'];

const featuredPost = {
	title: 'The Complete Guide to Building a Net-Zero Energy Home in the Mountains',
	excerpt: 'Discover how modern building techniques and renewable energy systems can help you create a home that produces as much energy as it consumes, even in the challenging conditions of the Appalachian mountains.',
	author: 'Andrew Walker',
	date: 'December 15, 2024',
	readTime: '12 min read',
	category: 'Green Building',
	image: 'https://placehold.co/1200x600/2D6A4F/ffffff?text=Net+Zero+Home+Guide',
	slug: '#',
};

const posts = [
	{
		title: 'Top 10 Questions to Ask Your Contractor Before Starting a Renovation',
		excerpt: 'Protect your investment and ensure a smooth renovation process by asking these critical questions.',
		author: 'Benjamin Walker',
		date: 'December 8, 2024',
		readTime: '8 min read',
		category: 'Renovation Tips',
		image: 'https://placehold.co/600x400/E9B84A/1C1F1A?text=Questions+for+Contractor',
		slug: '#',
	},
	{
		title: 'Mountain Home Design Trends for 2025',
		excerpt: 'From indoor-outdoor living spaces to sustainable materials, here are the top trends shaping mountain home design.',
		author: 'Sarah Martinez',
		date: 'November 28, 2024',
		readTime: '6 min read',
		category: 'Design Trends',
		image: 'https://placehold.co/600x400/74502A/ffffff?text=Design+Trends+2025',
		slug: '#',
	},
	{
		title: "How We Restored a 1920s Craftsman Home in Boone",
		excerpt: "A behind-the-scenes look at the challenges and triumphs of preserving this piece of Western NC history.",
		author: 'Andrew Walker',
		date: 'November 15, 2024',
		readTime: '10 min read',
		category: 'Project Spotlights',
		image: 'https://placehold.co/600x400/5C6047/ffffff?text=1920s+Craftsman+Restoration',
		slug: '#',
	},
	{
		title: 'Understanding Building Permits in Yancey County',
		excerpt: 'Navigate the permit process smoothly with our comprehensive guide to local building regulations.',
		author: 'Benjamin Walker',
		date: 'November 5, 2024',
		readTime: '7 min read',
		category: 'New Construction',
		image: 'https://placehold.co/600x400/2D6A4F/ffffff?text=Building+Permits+Guide',
		slug: '#',
	},
	{
		title: '5 Sustainable Building Materials You Should Know About',
		excerpt: 'Eco-friendly options that are better for the environment and can actually improve your home\'s energy efficiency.',
		author: 'Sarah Martinez',
		date: 'October 25, 2024',
		readTime: '9 min read',
		category: 'Green Building',
		image: 'https://placehold.co/600x400/2D6A4F/ffffff?text=Sustainable+Materials',
		slug: '#',
	},
];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero (AC5) -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2 pointer-events-none"></div>
		<div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-white/[0.02] -rotate-12 translate-x-1/3 pointer-events-none"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Insights & Updates</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						The Blog
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Expert tips, project spotlights, and construction insights from the A&B team.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Category Filter -->
	<section class="py-8 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-wrap gap-3 justify-center">
				{categories.map((category) => (
					<button class={`px-6 py-2 rounded-full font-heading font-semibold text-sm uppercase tracking-wide transition-all ${
						category === 'All'
							? 'bg-construction-primary text-white'
							: 'bg-white text-construction-dark border border-gray-300 hover:bg-construction-primary/10'
					}`}>
						{category}
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Post (AC2 — border-t-4, no rounding) -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Featured Article</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Editor's Pick
					</h2>
				</div>
			</FadeInSection>

			<FadeInSection client:load delay={0.2}>
				<a href={featuredPost.slug} class="group block bg-white border-t-4 border-construction-primary hover:shadow-xl transition-shadow overflow-hidden">
					<div class="grid lg:grid-cols-2">
						<div class="h-64 lg:h-auto overflow-hidden">
							<img
								src={featuredPost.image}
								alt={featuredPost.title}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
						</div>
						<div class="p-8 lg:p-12 flex flex-col justify-center">
							<div class="flex items-center gap-4 mb-4">
								<span class="px-3 py-1 bg-construction-accent text-construction-dark font-heading text-xs uppercase tracking-wide">
									{featuredPost.category}
								</span>
								<span class="text-gray-700 text-sm">{featuredPost.readTime}</span>
							</div>
							<h2 class="font-heading text-3xl font-bold text-construction-dark mb-4">
								{featuredPost.title}
							</h2>
							<p class="text-gray-700 mb-6">
								{featuredPost.excerpt}
							</p>
							<div class="flex items-center text-sm text-gray-700">
								<div class="w-8 h-8 bg-construction-primary/10 flex items-center justify-center mr-3">
									<span class="font-heading font-bold text-construction-primary text-xs">{featuredPost.author.split(' ').map(n => n[0]).join('')}</span>
								</div>
								<div>
									<div class="font-semibold text-construction-dark font-heading uppercase tracking-wide">{featuredPost.author}</div>
									<div>{featuredPost.date}</div>
								</div>
							</div>
							<div class="mt-6">
								<span class="inline-flex items-center text-construction-primary font-semibold hover:underline">
									Read More →
								</span>
							</div>
						</div>
					</div>
				</a>
			</FadeInSection>
		</div>
	</section>

	<!-- Posts Grid (AC2 — border-t-4, no rounding) -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Latest Articles</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Recent Posts
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a href={post.slug} class="group flex flex-col bg-white border-t-4 border-construction-primary hover:shadow-xl transition-shadow h-full">
							<div class="h-48 overflow-hidden">
								<img
									src={post.image}
									alt={post.title}
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								/>
							</div>
							<div class="p-6 flex flex-col flex-1">
								<div class="flex items-center gap-3 mb-4">
									<span class="px-3 py-1 bg-construction-accent/20 text-construction-dark font-heading text-xs uppercase tracking-wide">
										{post.category}
									</span>
									<span class="text-gray-700 text-xs">{post.readTime}</span>
								</div>
								<h3 class="font-heading text-xl font-bold text-construction-dark mb-3 flex-1">
									{post.title}
								</h3>
								<p class="text-gray-700 text-sm mb-4">
									{post.excerpt}
								</p>
								<div class="flex items-center justify-between text-sm text-gray-700 mt-auto pt-4 border-t border-gray-100">
									<div class="font-heading font-bold text-construction-dark uppercase tracking-wide text-xs">{post.author}</div>
									<div>{post.date}</div>
								</div>
							</div>
						</a>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Newsletter CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Stay in the Loop
				</h2>
				<p class="text-xl text-white/60 mb-10 max-w-2xl mx-auto">
					Get construction tips, project updates, and exclusive insights delivered to your inbox.
				</p>
				<form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
					<input
						type="email"
						placeholder="Your email address"
						class="flex-1 px-6 py-4 bg-white text-construction-dark placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-construction-accent"
						required
					/>
					<button
						type="submit"
						class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all whitespace-nowrap"
					>
						Subscribe
					</button>
				</form>
			</FadeInSection>
		</div>
	</section>

	<!-- CTA Band -->
	<section class="py-20 bg-construction-light border-t border-gray-200">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-4xl font-bold text-construction-dark mb-4">
					Ready to Start Your Project?
				</h2>
				<p class="text-xl text-gray-700 mb-8">
					Put our expertise to work for you.
				</p>
				<a
					href="/contact"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Get a Free Quote
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
