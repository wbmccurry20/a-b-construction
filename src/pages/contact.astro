---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import ContactForm from '../components/ContactForm';

const pageTitle = "Contact A&B Construction | Get Your Free Quote";
const pageDescription = "Ready to start your construction project? Contact A&B Construction for a free consultation and quote. Serving Western North Carolina.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero (AC5) -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2 pointer-events-none"></div>
		<div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-white/[0.02] -rotate-12 translate-x-1/3 pointer-events-none"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Get In Touch</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						Let's Build Something Amazing
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Ready to start your project? Get a free consultation and discover how we can bring your vision to life.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Contact Section (AC8 — 2-column: info left, form right) -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-3 gap-12">

				<!-- Left: Contact Info Cards -->
				<div class="lg:col-span-1 space-y-6">
					<FadeInSection client:load>
						<h3 class="font-heading text-2xl font-bold text-construction-dark mb-6 uppercase tracking-wide">
							Get in Touch
						</h3>

						<!-- Phone -->
						<div class="flex items-start space-x-4 bg-white p-6 border-t-4 border-construction-primary">
							<div class="w-12 h-12 bg-construction-primary/10 flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
								</svg>
							</div>
							<div>
								<h4 class="font-heading font-bold text-construction-dark uppercase tracking-wide mb-1">Phone</h4>
								<a href="tel:+18283352845" class="text-construction-primary hover:underline">
									(828) 335-2845
								</a>
								<p class="text-sm text-gray-700 mt-1">
									Mon-Fri: 8am-6pm<br />Sat: 9am-4pm
								</p>
							</div>
						</div>

						<!-- Email -->
						<div class="flex items-start space-x-4 bg-white p-6 border-t-4 border-construction-primary">
							<div class="w-12 h-12 bg-construction-primary/10 flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
								</svg>
							</div>
							<div>
								<h4 class="font-heading font-bold text-construction-dark uppercase tracking-wide mb-1">Email</h4>
								<a href="mailto:drew@abconstruction.builders" class="text-construction-primary hover:underline text-sm">
									drew@abconstruction.builders
								</a>
								<p class="text-sm text-gray-700 mt-1">
									We respond within 24 hours
								</p>
							</div>
						</div>

						<!-- Address -->
						<div class="flex items-start space-x-4 bg-white p-6 border-t-4 border-construction-primary">
							<div class="w-12 h-12 bg-construction-primary/10 flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
								</svg>
							</div>
							<div>
								<h4 class="font-heading font-bold text-construction-dark uppercase tracking-wide mb-1">Office</h4>
								<p class="text-gray-700">
									120 W Main Street<br />
									Burnsville, NC 28714
								</p>
								<a href="https://maps.google.com/?q=120+W+Main+Street,+Burnsville,+NC+28714" target="_blank" rel="noopener noreferrer" class="text-construction-primary text-sm hover:underline mt-2 inline-block">
									Get Directions →
								</a>
							</div>
						</div>

						<!-- Service Areas -->
						<div class="bg-white p-6 border-t-4 border-construction-secondary">
							<h4 class="font-heading font-bold text-construction-dark uppercase tracking-wide mb-3">Service Areas</h4>
							<div class="grid grid-cols-2 gap-2 text-sm text-gray-700">
								{['Burnsville', 'Boone', 'Blowing Rock', 'Hendersonville', 'Brevard', 'Banner Elk'].map(area => (
									<div class="flex items-center">
										<svg class="w-4 h-4 text-construction-primary mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
										</svg>
										{area}
									</div>
								))}
							</div>
						</div>
					</FadeInSection>
				</div>

				<!-- Right: Contact Form -->
				<div class="lg:col-span-2">
					<FadeInSection client:load delay={0.2}>
						<div class="bg-white p-8 border-t-4 border-construction-primary shadow-lg">
							<h2 class="font-heading text-3xl font-bold text-construction-dark mb-2 uppercase tracking-wide">
								Get Your Free Quote
							</h2>
							<p class="text-gray-700 mb-8">
								Fill out the form below and we'll get back to you within 24 hours.
							</p>
							<ContactForm client:load />
						</div>
					</FadeInSection>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="py-20 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Common Questions</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						FAQs
					</h2>
					<p class="text-xl text-gray-700 mt-4">
						Quick answers to help you get started
					</p>
				</div>
			</FadeInSection>

			<div class="space-y-4">
				{[
					{
						q: "How quickly can you start my project?",
						a: "Our timeline varies based on project scope and current schedule. Typically, we can begin planning within 1-2 weeks of initial consultation. Construction start dates depend on permits, materials, and weather conditions."
					},
					{
						q: "Do you offer free estimates?",
						a: "Yes! We provide free, no-obligation consultations and estimates. After an initial site visit and discussion of your needs, we'll provide a detailed quote within 3-5 business days."
					},
					{
						q: "Are you licensed and insured?",
						a: "Absolutely. We're fully licensed, bonded, and insured in North Carolina. We carry comprehensive liability and workers' compensation insurance for your protection."
					},
					{
						q: "What areas do you serve?",
						a: "We primarily serve Western North Carolina, including Asheville, Boone, Blowing Rock, Hendersonville, Brevard, and Banner Elk. Contact us if you're outside these areas."
					},
				].map((faq, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<details class="bg-construction-light p-6 group">
							<summary class="font-heading font-bold text-construction-dark cursor-pointer list-none flex items-center justify-between uppercase tracking-wide">
								{faq.q}
								<svg class="w-5 h-5 text-construction-primary group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<p class="mt-4 text-gray-700">
								{faq.a}
							</p>
						</details>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Dark Bottom Band (AC8) -->
	<section class="py-20 bg-construction-dark text-center">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Ready to Build?
				</h2>
				<p class="text-xl text-white/60 mb-4">
					120 W Main Street, Burnsville, NC 28714
				</p>
				<p class="text-white/40 mb-10">
					Serving Western North Carolina — Burnsville · Boone · Asheville · Hendersonville · Brevard
				</p>
				<a
					href="tel:+18283352845"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Call (828) 335-2845
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
