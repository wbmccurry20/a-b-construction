---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import { site, serviceCategories, projects, placeholderImages } from '../data/site';

const pageTitle = "Commercial Construction | A&B Construction, Western NC";
const pageDescription = "Light commercial facilities, traveling commercial builds, specialty structures, and subcontracted projects by A&B Construction, based in Western North Carolina.";

const division = 'commercial';
const divisionServices = serviceCategories.filter((s) => s.division === division);
const divisionProjects = projects.filter((p) => p.division === division);
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<img
				src={placeholderImages.commercialHero}
				alt="Commercial construction project by A&B Construction"
				class="w-full h-full object-cover"
				loading="eager"
			/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-construction-dark via-construction-dark/90 to-construction-dark/40"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Commercial</p>
					<h1 class="font-heading text-5xl md:text-7xl font-bold text-white mb-6">
						Commercial builds,<br/>managed & supervised.
					</h1>
					<p class="text-xl text-white/70 max-w-xl">
						Light commercial facilities, traveling builds, specialty structures, and
						subcontracted work — delivered with on-site supervision and reliable scheduling.
					</p>
					<a
						href="/contact"
						class="inline-flex items-center mt-8 px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Discuss Your Build
						<svg class="ml-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Services -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What We Build</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Commercial Services
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 gap-8">
				{divisionServices.map((service, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-l-4 border-construction-primary shadow-md h-full">
							<h3 class="font-heading text-2xl font-bold text-construction-dark mb-2">{service.title}</h3>
							<p class="text-gray-700 mb-6">{service.tagline}</p>
							<ul class="space-y-2">
								{service.items.map((item) => (
									<li class="flex items-start text-gray-700">
										<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
										</svg>
										{item}
									</li>
								))}
							</ul>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Featured commercial projects -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Selected Work</p>
						<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
							Commercial Projects
						</h2>
					</div>
					<a href="/portfolio" class="inline-flex items-center text-construction-primary font-heading uppercase tracking-wider text-sm hover:text-construction-accent transition-colors">
						View full portfolio
						<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{divisionProjects.map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a href="/portfolio" class="group block relative aspect-[4/3] overflow-hidden">
							<img
								src={project.image}
								alt={`${project.title} — ${project.location}`}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-construction-dark/90 to-transparent"></div>
							<div class="absolute bottom-0 left-0 p-6">
								<p class="font-heading text-xs uppercase tracking-widest text-construction-accent mb-1">{project.category}</p>
								<h3 class="font-heading text-xl font-bold text-white">{project.title}</h3>
								<p class="text-white/70 text-sm">{project.location}</p>
							</div>
						</a>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-4xl md:text-6xl font-bold text-white mb-6">
					Have a commercial project?
				</h2>
				<p class="text-xl text-white/60 mb-8">
					From facility builds to subcontracted scopes, tell us what you need and we'll scope it with you.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all">
						Get a Quote
					</a>
					<a href="/residential" class="inline-flex items-center justify-center px-8 py-4 border border-white/40 text-white font-heading uppercase tracking-wider hover:bg-white/10 transition-all">
						See Residential
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
