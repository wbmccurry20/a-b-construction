---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "How We Build | A&B Construction";
const pageDescription = "Our straightforward construction process — from first call to move-in day. No surprises, no runaround. Just honest work in Western NC.";

const steps = [
	{
		number: '01',
		title: 'Free Consultation',
		description: "We start with a conversation — no pitch, no pressure. Tell us what you're thinking, and we'll tell you honestly what it takes to get there.",
	},
	{
		number: '02',
		title: 'Site Visit & Scope',
		description: "We come to you. Walking the site with you in person is the only way to give you a real number. We look at access, grade, soil, utilities — everything that affects cost.",
	},
	{
		number: '03',
		title: 'Proposal & Contract',
		description: "You get a written scope of work with a fixed-price proposal. No vague estimates that balloon later. If something is uncertain, we tell you upfront.",
	},
	{
		number: '04',
		title: 'Permits & Planning',
		description: "We pull all permits, coordinate with engineers if needed, and nail down the material order before a shovel hits the ground. This is where we prevent problems.",
	},
	{
		number: '05',
		title: 'Construction',
		description: "Our own crew does the work — the same faces you met on day one. Drew is on-site regularly. You get his number and can call or text any time.",
	},
	{
		number: '06',
		title: 'Walk-Through & Warranty',
		description: "Before we call it done, you walk every inch with us. Anything that isn't right gets fixed. We stand behind our work with a written warranty.",
	},
];

const truths = [
	"Construction always has surprises. A good contractor plans for them — we keep a contingency budget and tell you when we draw from it.",
	"The cheapest bid is rarely the best bid. We'd rather lose a job than promise a number we can't deliver.",
	"Timelines slip when materials are late or weather is bad. We'll always tell you why — not make up excuses.",
];

const faqs = [
	{
		question: 'How long does a custom home take to build in Western NC?',
		answer: 'Most custom homes in our size range (1,500–3,500 sq ft) take 10–14 months from permit approval to move-in. Smaller additions and renovations are typically 6–12 weeks. Mountain sites with difficult access or steep grades can add time — we\'ll tell you in the site visit if that applies to your project.',
	},
	{
		question: 'Do you handle building permits?',
		answer: "Yes. We pull all permits, coordinate with Yancey County (or the relevant county) building inspections, and manage the inspection schedule. You don't have to deal with any of that.",
	},
	{
		question: 'Can I make changes once construction starts?',
		answer: "Yes, but changes mid-build cost more than changes on paper. We'll always give you a written change order with a price before doing any extra work. No surprises.",
	},
	{
		question: 'What areas do you serve?',
		answer: "We primarily serve Yancey, Mitchell, Avery, Madison, and Buncombe counties. We'll consider projects in surrounding areas — give us a call and we'll let you know.",
	},
	{
		question: 'What warranty do you provide?',
		answer: "We provide a written 1-year workmanship warranty on all projects. Structural elements follow North Carolina's statutory warranties. Manufacturer warranties on materials (windows, roofing, HVAC) are passed through to you at closing.",
	},
];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Process</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						How We Build
					</h1>
					<p class="text-white/60 text-xl max-w-2xl">
						Six steps from first call to finished home. You'll know what's happening at every stage — no guessing, no surprises.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Six Steps -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-14">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Step by Step</p>
					<h2 class="font-heading text-5xl font-bold text-construction-dark">
						The Full Picture
					</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-2 gap-8">
				{steps.map((step, index) => (
					<FadeInSection client:load delay={index * 0.08}>
						<div class="bg-white p-8 border-l-4 border-construction-primary relative overflow-hidden">
							<span class="absolute top-4 right-6 font-heading text-8xl font-bold text-construction-primary/10 leading-none select-none">
								{step.number}
							</span>
							<p class="font-heading text-xs uppercase tracking-widest text-construction-primary mb-2">
								Step {step.number}
							</p>
							<h3 class="font-heading text-2xl font-bold text-construction-dark mb-4">
								{step.title}
							</h3>
							<p class="text-gray-700 leading-relaxed">
								{step.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- What We'll Tell You Upfront -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-14">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">No Runaround</p>
					<h2 class="font-heading text-5xl font-bold text-white">
						What We'll Tell You Upfront
					</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-3 gap-6">
				{truths.map((truth, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="border-t-4 border-construction-accent bg-white/5 p-8">
							<p class="text-white/80 leading-relaxed text-lg">
								{truth}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-14">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Common Questions</p>
					<h2 class="font-heading text-5xl font-bold text-construction-dark">
						FAQ
					</h2>
				</div>
			</FadeInSection>
			<div class="space-y-3">
				{faqs.map((faq) => (
					<details class="group bg-white border-l-4 border-construction-primary">
						<summary class="flex items-center justify-between px-8 py-6 cursor-pointer list-none">
							<span class="font-heading font-bold text-construction-dark text-lg pr-4">
								{faq.question}
							</span>
							<span class="flex-shrink-0 w-6 h-6 text-construction-primary transition-transform group-open:rotate-45">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
								</svg>
							</span>
						</summary>
						<div class="px-8 pb-6 text-gray-700 leading-relaxed">
							{faq.answer}
						</div>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Band -->
	<section class="py-24 bg-construction-dark text-center">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Ready to Talk?
				</h2>
				<p class="text-white/60 text-xl mb-10">
					The first conversation is free and there's no obligation.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="tel:+18283352845"
						class="px-10 py-5 bg-construction-primary text-white font-heading text-xl uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						Call (828) 335-2845
					</a>
					<a
						href="/contact"
						class="px-10 py-5 border border-white/20 text-white font-heading text-xl uppercase tracking-wider hover:border-white/60 transition-all"
					>
						Or send us a message →
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
