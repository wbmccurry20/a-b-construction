---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Construction Services | A&B Construction WNC";
const pageDescription = "Custom homes, renovations, additions, and remodeling services from A&B Construction. Serving Western North Carolina since 2004.";

const services = [
	{
		id: 'new-construction',
		title: 'New Construction',
		tagline: 'Custom homes built to your vision',
		description: 'Build your dream home from the ground up with our comprehensive new construction services. We handle everything from initial design consultation to final walkthrough.',
		features: [
			'Custom architectural design',
			'Foundation to finish management',
			'Smart home integration',
			'Energy-efficient systems',
			'Local material sourcing',
			'LEED certification assistance',
		],
		image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=New+Construction',
		accent: 'construction-primary',
	},
	{
		id: 'renovations',
		title: 'Renovations',
		tagline: 'Transform your existing space',
		description: 'Breathe new life into your existing home with our expert renovation services. We specialize in whole-home renovations, historic restorations, and targeted updates.',
		features: [
			'Whole-home renovations',
			'Historic restoration',
			'Structural improvements',
			'Systems upgrades',
			'Cosmetic updates',
			'Energy efficiency upgrades',
		],
		image: 'https://placehold.co/800x600/E9B84A/1C1F1A?text=Renovations',
		accent: 'construction-secondary',
	},
	{
		id: 'additions',
		title: 'Additions',
		tagline: 'Expand your living space',
		description: "When your family grows or your needs change, our addition services seamlessly expand your home's footprint while matching your existing architecture.",
		features: [
			'Second-story additions',
			'Master suite additions',
			'In-law suites',
			'Home office additions',
			'Sunrooms & four-season rooms',
			'Garage additions',
		],
		image: 'https://placehold.co/800x600/74502A/ffffff?text=Additions',
		accent: 'construction-secondary',
	},
	{
		id: 'remodeling',
		title: 'Remodeling',
		tagline: 'Kitchen, bath, and beyond',
		description: 'Targeted remodeling services that transform your most-used spaces. From kitchen and bathroom remodels to basement finishing and custom built-ins.',
		features: [
			'Kitchen remodeling',
			'Bathroom remodeling',
			'Basement finishing',
			'Custom cabinetry',
			'Flooring installation',
			'Interior design services',
		],
		image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=Remodeling',
		accent: 'construction-primary',
	},
	{
		id: 'outdoor',
		title: 'Outdoor Living',
		tagline: 'Extend your home outdoors',
		description: 'Create stunning outdoor spaces that blend with our mountain landscape. Decks, patios, outdoor kitchens, and more.',
		features: [
			'Decks & porches',
			'Patios & outdoor kitchens',
			'Fire pits & hardscaping',
			'Retaining walls',
			'Landscape integration',
			'Outdoor lighting',
		],
		image: 'https://placehold.co/800x600/5C6047/ffffff?text=Outdoor+Living',
		accent: 'construction-stone',
	},
	{
		id: 'green-building',
		title: 'Green Building',
		tagline: 'Build with the environment in mind',
		description: 'Our sustainable building practices reduce environmental impact while creating more comfortable, energy-efficient homes that save you money long-term.',
		features: [
			'LEED certification',
			'Solar integration',
			'Geothermal systems',
			'Recycled materials',
			'Energy audits',
			'Net-zero design',
		],
		image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=Green+Building',
		accent: 'construction-primary',
	},
];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero (AC5) -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2 pointer-events-none"></div>
		<div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-white/[0.02] -rotate-12 translate-x-1/3 pointer-events-none"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Services</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						What We Build
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Comprehensive construction services for every stage of your home — from the ground up or from where you are now.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Services Grid (AC2 — border-t-4, no rounding, no hover:scale) -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Full Service</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Comprehensive Construction
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-3xl">
						From dream homes to targeted renovations, we handle every stage of the build with expert craftsmanship.
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{services.map((service, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div id={service.id} class="bg-white border-t-4 border-construction-primary hover:shadow-xl transition-shadow flex flex-col h-full">
							<div class="h-48 overflow-hidden">
								<img
									src={service.image}
									alt={service.title}
									class="w-full h-full object-cover"
								/>
							</div>
							<div class="p-8 flex flex-col flex-1">
								<h3 class="font-heading text-2xl font-bold text-construction-dark mb-2">
									{service.title}
								</h3>
								<p class="text-construction-primary font-heading text-sm uppercase tracking-wide mb-4">
									{service.tagline}
								</p>
								<p class="text-gray-700 mb-6 flex-1">
									{service.description}
								</p>
								<ul class="space-y-2 mb-8">
									{service.features.map(feature => (
										<li class="flex items-center text-sm text-gray-700">
											<svg class="w-4 h-4 text-construction-primary mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
											</svg>
											{feature}
										</li>
									))}
								</ul>
								<a
									href="/contact"
									class="inline-flex items-center px-6 py-3 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-lg transition-all text-sm w-full justify-center"
								>
									Get a Quote
								</a>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Our Process -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">How We Work</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Process
					</h2>
					<p class="text-xl text-gray-700 mt-4">
						A transparent, step-by-step approach to every project
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ step: '01', title: 'Consultation', desc: 'Free initial meeting to understand your vision, budget, and timeline.' },
					{ step: '02', title: 'Design & Quote', desc: 'Detailed plans and transparent pricing within 5 business days.' },
					{ step: '03', title: 'Build', desc: 'Expert construction with regular updates and open communication.' },
					{ step: '04', title: 'Handover', desc: 'Final walkthrough, warranty documentation, and post-project support.' },
				].map((item, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-construction-light border-t-4 border-construction-primary p-8 hover:shadow-xl transition-shadow">
							<div class="font-heading text-4xl font-bold text-construction-primary/20 mb-4">{item.step}</div>
							<h3 class="font-heading text-xl font-bold text-construction-dark mb-3">{item.title}</h3>
							<p class="text-gray-700 text-sm">{item.desc}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Quick Answers</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Service FAQs
					</h2>
				</div>
			</FadeInSection>

			<div class="space-y-4">
				{[
					{ q: "How much does a custom home cost?", a: "New home costs vary widely based on size, location, materials, and design complexity. In Western NC, expect $150–$300+ per square foot. We provide detailed, itemized quotes after our consultation." },
					{ q: "How long does a typical renovation take?", a: "Project timelines depend on scope. A kitchen remodel may take 4–8 weeks; whole-home renovations can take 3–6 months. We provide a detailed timeline during the planning phase." },
					{ q: "Do you handle the permits?", a: "Yes, we handle all necessary permits and inspections. We're familiar with local building codes and requirements in all the counties we serve." },
					{ q: "Can I customize everything?", a: "Absolutely. Every project we take on is custom. We work with you to select materials, finishes, fixtures, and design elements that reflect your style and budget." },
				].map((faq, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<details class="bg-white p-6 group">
							<summary class="font-heading font-bold text-construction-dark cursor-pointer list-none flex items-center justify-between uppercase tracking-wide">
								{faq.q}
								<svg class="w-5 h-5 text-construction-primary group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<p class="mt-4 text-gray-700">
								{faq.a}
							</p>
						</details>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Let's Talk About Your Project
				</h2>
				<p class="text-xl text-white/60 mb-10">
					Get a free consultation with our team.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Get a Free Quote
					</a>
					<a
						href="tel:+18283352845"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						Call Us Now
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
