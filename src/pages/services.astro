---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import { serviceCategories, operatingModel } from '../data/site';

const pageTitle = "Services | A&B Construction — Residential & Commercial, Western NC";
const pageDescription = "Full-service construction from A&B Construction: residential custom homes, renovations and additions, commercial facilities, and specialty projects across Western North Carolina.";

const operatingHighlights = operatingModel.filter((item) => item.body);
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Services</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						What We Build
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Full-service residential and commercial construction — from custom homes and
						renovations to commercial facilities and specialty projects.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Division shortcuts -->
	<section class="py-16 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 gap-6">
				{[
					{ label: 'Residential', href: '/residential', blurb: 'Custom homes, renovations, additions, and specialty residential builds.' },
					{ label: 'Commercial', href: '/commercial', blurb: 'Light commercial facilities, traveling builds, and subcontracted work.' },
				].map((d) => (
					<a href={d.href} class="group block bg-construction-dark p-8 hover:bg-black transition-colors">
						<h2 class="font-heading text-3xl font-bold text-white mb-2 group-hover:text-construction-accent transition-colors">{d.label}</h2>
						<p class="text-white/70 mb-4">{d.blurb}</p>
						<span class="inline-flex items-center text-construction-accent font-heading uppercase tracking-wider text-sm">
							Explore {d.label}
							<svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
							</svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Services Grid -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Full Service</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Comprehensive Construction
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 gap-8">
				{serviceCategories.map((service, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div id={service.id} class="bg-construction-light border-t-4 border-construction-primary p-8 flex flex-col h-full">
							<p class="font-heading text-xs uppercase tracking-widest text-construction-stone mb-2">{service.division}</p>
							<h3 class="font-heading text-2xl font-bold text-construction-dark mb-2">
								{service.title}
							</h3>
							<p class="text-construction-primary font-heading text-sm uppercase tracking-wide mb-5">
								{service.tagline}
							</p>
							<ul class="space-y-2 mb-8 flex-1">
								{service.items.map((feature) => (
									<li class="flex items-start text-gray-700">
										<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
										</svg>
										{feature}
									</li>
								))}
							</ul>
							<a
								href={`/${service.division}`}
								class="inline-flex items-center px-6 py-3 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-lg transition-all text-sm w-full justify-center"
							>
								Learn More
							</a>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- How We Operate -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">How We Operate</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						The way we work
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{operatingHighlights.map((item, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-l-4 border-construction-primary h-full shadow-md">
							<h3 class="font-heading text-xl font-bold text-construction-dark mb-3">{item.title}</h3>
							<p class="text-gray-700 leading-relaxed">{item.body}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="py-20 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Quick Answers</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Service FAQs
					</h2>
				</div>
			</FadeInSection>

			<div class="space-y-4">
				{[
					{ q: "Do you handle both residential and commercial work?", a: "Yes. We're a full-service firm covering residential custom homes, renovations and additions, as well as commercial facilities, specialty structures, and subcontracted project work." },
					{ q: "How is pricing determined?", a: "Project costs vary with size, site conditions, materials, and finish level. We provide detailed, itemized quotes after an initial consultation and site review." },
					{ q: "Do you handle permits?", a: "Yes, we coordinate the necessary permits and inspections for the work we take on, and we're familiar with local building requirements across the areas we serve." },
					{ q: "How do you manage the build?", a: "We work through an established subcontractor network with direct on-site supervision, so each job stays coordinated from site preparation through final finishings." },
				].map((faq, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<details class="bg-construction-light p-6 group">
							<summary class="font-heading font-bold text-construction-dark cursor-pointer list-none flex items-center justify-between uppercase tracking-wide">
								{faq.q}
								<svg class="w-5 h-5 text-construction-primary group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<p class="mt-4 text-gray-700">
								{faq.a}
							</p>
						</details>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Let's Talk About Your Project
				</h2>
				<p class="text-xl text-white/60 mb-10">
					Residential or commercial — tell us what you're planning.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Get a Quote
					</a>
					<a
						href="/portfolio"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						See Our Work
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
