---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import Footer from '../components/Footer';

const pageTitle = "Our Portfolio | A&B Construction Projects";
const pageDescription = "Browse our portfolio of completed residential construction projects including custom homes, renovations, and additions in Western North Carolina.";

const projects = [
	{
		id: 1,
		title: 'Modern Mountain Retreat',
		location: 'Asheville, NC',
		category: 'New Construction',
		year: '2025',
		sqft: '3,200 sq ft',
		image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=Modern+Mountain+Retreat',
		description: 'A stunning contemporary home featuring floor-to-ceiling windows, sustainable materials, and smart home integration. Built to passive house standards.',
		features: ['Solar panels', 'Rainwater collection', 'Geothermal heating', 'Smart home system'],
	},
	{
		id: 2,
		title: 'Historic Craftsman Revival',
		location: 'Boone, NC',
		category: 'Renovation',
		year: '2024',
		sqft: '2,800 sq ft',
		image: 'https://placehold.co/800x600/E9B84A/1C1F1A?text=Historic+Craftsman',
		description: 'Complete restoration of a 1920s craftsman home, preserving original character while adding modern amenities and energy efficiency.',
		features: ['Original hardwood restored', 'Updated electrical/plumbing', 'Energy-efficient windows', 'Modern kitchen'],
	},
	{
		id: 3,
		title: 'Family Addition',
		location: 'Blowing Rock, NC',
		category: 'Addition',
		year: '2024',
		sqft: '1,500 sq ft',
		image: 'https://placehold.co/800x600/74502A/ffffff?text=Family+Addition',
		description: "Two-bedroom second-story addition with master suite and home office, seamlessly matching the existing home's architecture.",
		features: ['Two bedrooms', 'Master bathroom', 'Home office', 'Deck expansion'],
	},
	{
		id: 4,
		title: 'Luxury Kitchen Remodel',
		location: 'Asheville, NC',
		category: 'Renovation',
		year: '2025',
		sqft: '450 sq ft',
		image: 'https://placehold.co/800x600/5C6047/ffffff?text=Luxury+Kitchen',
		description: 'High-end kitchen transformation with custom cabinetry, premium appliances, and open concept design.',
		features: ['Custom cabinets', 'Quartz countertops', 'Professional appliances', 'Smart lighting'],
	},
	{
		id: 5,
		title: 'Outdoor Living Paradise',
		location: 'Hendersonville, NC',
		category: 'Outdoor',
		year: '2024',
		sqft: '800 sq ft',
		image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=Outdoor+Living',
		description: 'Complete outdoor entertainment space with covered deck, outdoor kitchen, fire pit, and landscaping.',
		features: ['Covered deck', 'Outdoor kitchen', 'Fire pit', 'Professional landscaping'],
	},
	{
		id: 6,
		title: 'Custom Home Build',
		location: 'Banner Elk, NC',
		category: 'New Construction',
		year: '2025',
		sqft: '2,500 sq ft',
		image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=Net+Zero+Green+Home',
		description: 'Custom home build featuring energy-efficient construction and quality materials throughout.',
		features: ['Energy-efficient systems', 'Triple-pane windows', 'Recycled materials', 'Quality materials'],
	},
];

const categories = ['All', 'New Construction', 'Renovation', 'Addition', 'Outdoor'];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero (AC5) -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Work</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						Portfolio
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Explore our completed projects across Western North Carolina.
						From custom homes to complete renovations, see the quality and craftsmanship we deliver.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Stats Band (AC7 — bg-construction-primary, 4-column) -->
	<section class="bg-construction-primary py-12">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center text-white">
				<div>
					<div class="font-heading text-4xl md:text-5xl font-bold">20+</div>
					<div class="font-heading text-xs uppercase tracking-widest mt-1 text-white/70">Years in Business</div>
				</div>
				<div>
					<div class="font-heading text-4xl md:text-5xl font-bold">[X]+</div>
					<div class="font-heading text-xs uppercase tracking-widest mt-1 text-white/70">Projects Completed</div>
				</div>
				<div>
					<div class="font-heading text-4xl md:text-5xl font-bold">[X]%</div>
					<div class="font-heading text-xs uppercase tracking-widest mt-1 text-white/70">Happy Clients</div>
				</div>
				<div>
					<div class="font-heading text-4xl md:text-5xl font-bold">12+</div>
					<div class="font-heading text-xs uppercase tracking-widest mt-1 text-white/70">Counties Served</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Filter Section -->
	<section class="py-8 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-wrap gap-3 justify-center">
				{categories.map((category) => (
					<button class={`px-6 py-2 rounded-full font-heading font-semibold text-sm uppercase tracking-wide transition-all ${
						category === 'All'
							? 'bg-construction-primary text-white'
							: 'bg-white text-construction-dark border border-gray-300 hover:bg-construction-primary/10'
					}`}>
						{category}
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- Projects Grid (AC7 — full-bleed image cards) -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{projects.map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="group relative aspect-[4/3] overflow-hidden">
							<img
								src={project.image}
								alt={project.title}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-construction-dark/90 via-construction-dark/20 to-transparent"></div>
							<!-- Category tag -->
							<div class="absolute top-4 right-4">
								<span class="px-3 py-1 bg-construction-accent text-construction-dark font-heading text-xs uppercase tracking-wide">
									{project.category}
								</span>
							</div>
							<!-- Title overlay — slides up on hover -->
							<div class="absolute bottom-0 left-0 right-0 p-6 translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
								<p class="font-heading text-xs uppercase tracking-widest text-construction-accent mb-1">{project.location} · {project.year}</p>
								<h3 class="font-heading text-2xl font-bold text-white">{project.title}</h3>
								<div class="overflow-hidden max-h-0 group-hover:max-h-20 transition-all duration-300 mt-2">
									<p class="text-white/70 text-sm">{project.sqft}</p>
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Before/After Section (AC7 — dark bg, overline captions) -->
	<section class="py-20 bg-construction-dark border-t border-white/10">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">Transformation Gallery</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-white">
						See the Difference
					</h2>
					<p class="text-xl text-white/60 mt-4">
						Dramatic before and after results from our renovation work
					</p>
				</div>
			</FadeInSection>

			<div class="space-y-16">
				<FadeInSection client:load delay={0.2}>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-white/50 mb-4">Boone, NC — Historic Home Renovation</p>
						<BeforeAfterSlider
							client:load
							beforeImage="https://placehold.co/1200x800/74502A/ffffff?text=Before+-+Historic+Home"
							afterImage="https://placehold.co/1200x800/E9B84A/1C1F1A?text=After+-+Restored+Beauty"
							beforeAlt="Historic home before renovation"
							afterAlt="Historic home after renovation"
						/>
					</div>
				</FadeInSection>

				<FadeInSection client:load delay={0.3}>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-white/50 mb-4">Asheville, NC — Kitchen Remodel</p>
						<BeforeAfterSlider
							client:load
							beforeImage="https://placehold.co/1200x800/F7F3EC/1C1F1A?text=Before+-+Dated+Kitchen"
							afterImage="https://placehold.co/1200x800/2D6A4F/ffffff?text=After+-+Modern+Kitchen"
							beforeAlt="Kitchen before remodel"
							afterAlt="Kitchen after remodel"
						/>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Tagline Band (AC7) -->
	<section class="py-20 bg-construction-dark border-t border-white/10 text-center">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-4">
					Every Home Tells a Story.
				</h2>
				<p class="font-heading text-3xl md:text-4xl font-bold text-white/40 mb-12">
					Yours is next.
				</p>
				<a
					href="/contact"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Start Your Project
					<svg class="ml-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
