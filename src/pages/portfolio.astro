---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import { site, projects } from '../data/site';

const pageTitle = "Portfolio | A&B Construction Projects in Western NC";
const pageDescription = "Selected residential and commercial projects by A&B Construction across Western North Carolina — custom homes, renovations, commercial facilities, and subcontracted work.";

const categories = ['All', ...Array.from(new Set(projects.map((p) => p.category)))];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Work</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						Portfolio
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Selected residential and commercial projects across {site.serviceArea} —
						from custom homes to commercial facilities and subcontracted builds.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Filter Section -->
	<section class="py-8 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-wrap gap-3 justify-center">
				{categories.map((category) => (
					<button type="button" data-filter={category} class={`px-6 py-2 rounded-full font-heading font-semibold text-sm uppercase tracking-wide transition-all ${
						category === 'All'
							? 'bg-construction-primary text-white'
							: 'bg-white text-construction-dark border border-gray-300 hover:bg-construction-primary/10'
					}`}>
						{category}
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- Projects Grid -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{projects.map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div data-project-category={project.category} class="group relative aspect-[4/3] overflow-hidden">
							<img
								src={project.image}
								alt={`${project.title} — ${project.location}`}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-construction-dark/90 via-construction-dark/20 to-transparent"></div>
							<div class="absolute top-4 right-4">
								<span class="px-3 py-1 bg-construction-accent text-construction-dark font-heading text-xs uppercase tracking-wide">
									{project.category}
								</span>
							</div>
							<div class="absolute bottom-0 left-0 right-0 p-6 translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
								<p class="font-heading text-xs uppercase tracking-widest text-construction-accent mb-1">{project.location}</p>
								<h3 class="font-heading text-2xl font-bold text-white">{project.title}</h3>
								<div class="overflow-hidden max-h-0 group-hover:max-h-24 transition-all duration-300 mt-2">
									<p class="text-white/70 text-sm">
										{project.summaryTodo ? 'Project write-up coming soon.' : project.summary}
									</p>
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<script>
		const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const projectCards = document.querySelectorAll<HTMLElement>('[data-project-category]');

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const selectedFilter = button.dataset.filter;

				filterButtons.forEach((filterButton) => {
					const isActive = filterButton === button;
					filterButton.classList.toggle('bg-construction-primary', isActive);
					filterButton.classList.toggle('text-white', isActive);
					filterButton.classList.toggle('bg-white', !isActive);
					filterButton.classList.toggle('text-construction-dark', !isActive);
				});

				projectCards.forEach((card) => {
					card.hidden = selectedFilter !== 'All' && card.dataset.projectCategory !== selectedFilter;
				});
			});
		});
	</script>

	<!-- Tagline Band -->
	<section class="py-20 bg-construction-dark border-t border-white/10 text-center">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-4">
					Every project tells a story.
				</h2>
				<p class="font-heading text-3xl md:text-4xl font-bold text-white/40 mb-12">
					Yours is next.
				</p>
				<a
					href="/contact"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Start Your Project
					<svg class="ml-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
