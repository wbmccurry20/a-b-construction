---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "About A&B Construction | Custom Home Builders in Burnsville, NC";
const pageDescription = "A&B Construction has built and renovated custom homes in Western North Carolina since 2004. Meet the team behind more than 160 completed residential projects.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero (AC5) -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Story</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						About A&B Construction
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						A careful, direct building experience for homeowners across Western North Carolina.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- About Image Band -->
	<section class="bg-construction-dark">
		<div class="max-w-7xl mx-auto">
			<img
				src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1600&q=80"
				alt="A&B Construction crew framing a custom home in the Blue Ridge mountains"
				class="w-full h-[380px] md:h-[460px] object-cover"
				loading="lazy"
			/>
		</div>
	</section>

	<!-- Our Story -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-start">
				<FadeInSection client:load>
					<div>
							<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Built for this place</p>
						<h2 class="font-heading text-4xl md:text-5xl font-bold text-construction-dark mb-6">
							Our Story
						</h2>
						<div class="space-y-4 text-gray-700 text-lg">
							<p>A&B Construction builds and renovates custom homes in Western North Carolina. Founded in 2004, the company has completed more than 160 residential projects across Burnsville and the surrounding mountains.</p>
							<p>We take a limited number of residential projects each year so detailing, schedule, and site conditions get real attention. Mountain lots, existing foundations, and four-season weather are normal conditions for us — not exceptions.</p>
							<p>Every project is shaped by its setting. Access, grade, weather, and local materials all matter, so we take the time to understand the site before we promise a path forward.</p>
							<p>That means a practical conversation at the beginning, honest updates during the build, and a home that feels considered when the work is done — backed by a 2-year workmanship warranty.</p>
						</div>
					</div>
				</FadeInSection>

				<!-- By the Numbers (AC6 — flat dark panel) -->
				<FadeInSection client:load delay={0.2}>
					<div class="bg-construction-dark p-12 text-white">
						<h3 class="font-heading text-3xl font-semibold mb-8 tracking-wide">By the Numbers</h3>
						<div class="space-y-6">
							<div class="flex items-center border-b border-white/10 pb-6">
								<div class="font-heading text-5xl font-semibold text-construction-accent mr-6">20+</div>
								<div>
									<div class="font-heading font-semibold tracking-wide">Years in Business</div>
									<div class="text-[#C9C4BB] text-sm">Building in the mountains since 2004</div>
								</div>
							</div>
							<div class="flex items-center border-b border-white/10 pb-6">
								<div class="font-heading text-5xl font-semibold text-construction-accent mr-6">160+</div>
								<div>
									<div class="font-heading font-semibold tracking-wide">Projects Completed</div>
									<div class="text-[#C9C4BB] text-sm">New homes, renovations, and additions</div>
								</div>
							</div>
							<div class="flex items-center border-b border-white/10 pb-6">
								<div class="font-heading text-4xl font-semibold text-construction-accent mr-6">12</div>
								<div>
									<div class="font-heading font-semibold tracking-wide">Team Members</div>
									<div class="text-[#C9C4BB] text-sm">A small, accountable crew</div>
								</div>
							</div>
							<div class="flex items-center">
								<div class="font-heading text-4xl font-semibold text-construction-accent mr-6">4.9/5</div>
								<div>
									<div class="font-heading font-semibold tracking-wide">Client Satisfaction</div>
									<div class="text-[#C9C4BB] text-sm">Based on completed-project reviews</div>
								</div>
							</div>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
		<div class="mt-16 bg-construction-secondary p-8 text-center">
			<p class="font-heading text-xl text-white/80 max-w-3xl mx-auto">
				"We're not the biggest company in the mountains.
				<span class="text-construction-accent"> We're just the most careful.</span>"
			</p>
		</div>
	</section>

	<!-- Our Values (AC6 — border-t-4, no rounding) -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What Drives Us</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Core Values
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-3xl">
						These principles guide every decision we make and every project we undertake.
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						title: 'Quality First',
						description: 'We never compromise on quality. Every project receives our full attention to detail and commitment to excellence.',
					},
					{
						title: 'Integrity Always',
						description: 'Honest communication, transparent pricing, and ethical business practices are non-negotiable for us.',
					},
					{
						title: 'Sustainable Building',
						description: "We're committed to eco-friendly practices, energy-efficient designs, and reducing our environmental impact.",
					},
					{
						title: 'Client-Focused',
						description: 'Your vision, your budget, your timeline. We work for you and keep you involved every step of the way.',
					},
					{
						title: 'Innovation',
						description: 'We embrace modern technology and techniques while respecting traditional craftsmanship.',
					},
					{
						title: 'Community Impact',
						description: 'As locals, we care about our community and give back through volunteer work and local partnerships.',
					},
				].map((value, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-construction-primary hover:shadow-xl transition-shadow">
							<h3 class="font-heading text-2xl font-bold text-construction-dark mb-3">
								{value.title}
							</h3>
							<p class="text-gray-700">
								{value.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Working style -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">How we work</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						A small, accountable team
					</h2>
					<p class="text-xl text-gray-700 mt-4">
						The people and practices behind a more personal build
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						name: 'Aaron Blake',
						initials: 'AB',
						role: 'Principal / General Contractor',
						bio: '20 years of residential construction in the North Carolina mountains. Aaron oversees contracts, structure, and the final walkthrough on every project.',
						credentials: 'N.C. General Contractor License',
					},
					{
						name: 'Mara Ellison',
						initials: 'ME',
						role: 'Project Manager',
						bio: 'Mara runs schedule, selections, inspections, and owner communication from permit through punch list, keeping each build organized and on track.',
						credentials: 'Your single point of contact',
					},
					{
						name: 'Cole Harlan',
						initials: 'CH',
						role: 'Lead Carpenter',
						bio: 'Shop and field lead for finish carpentry, the exterior envelope, and crew quality. Cole sets the standard the whole crew builds to.',
						credentials: 'Finish carpentry & envelope lead',
					},
				].map((member, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="overflow-hidden hover:shadow-xl transition-shadow">
							<div class="aspect-square bg-construction-light flex items-center justify-center overflow-hidden">
								<span class="font-heading text-5xl font-bold text-construction-stone/40">{member.initials}</span>
							</div>
							<div class="p-6 bg-white border-t-4 border-construction-primary">
								<h3 class="font-heading text-2xl font-bold text-construction-dark uppercase tracking-wide mb-1">
									{member.name}
								</h3>
								<div class="text-construction-primary text-xs font-heading uppercase tracking-wider mb-4">
									{member.role}
								</div>
								<p class="text-gray-700 mb-4">
									{member.bio}
								</p>
								<div class="text-sm text-gray-700 italic">
									{member.credentials}
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Certifications -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Trusted & Certified</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Licensing & Credentials
					</h2>
					<p class="text-xl text-gray-700 mt-4">
						Project-specific credentials and documentation are available during consultation.
					</p>
				</div>
				<div class="bg-white border-t-4 border-construction-primary p-6 text-center max-w-sm">
					<div class="font-heading text-xl font-semibold text-construction-primary mb-2">
						N.C. General Contractor License
					</div>
					<div class="text-sm text-gray-700">
						Fully insured. Project-specific license and insurance documentation is available during consultation.
					</div>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Let's Build Something Together
				</h2>
				<p class="text-xl text-white/60 mb-8">
					Experience the A&B Construction difference. Schedule your free consultation today.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Get Started
					</a>
					<a
						href="/portfolio"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						See Our Work
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
