---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import { site, aboutCopy, operatingModel, team, placeholderImages } from '../data/site';

const pageTitle = "About A&B Construction | Residential & Commercial Builders in WNC";
const pageDescription = "A&B Construction is a locally owned, full-service residential and commercial construction firm in Western North Carolina. Meet our leadership team and how we operate.";

const partners = team.filter((m) => m.group === 'Partners');
const officers = team.filter((m) => m.group === 'Officers');
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Story</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						About {site.name}
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						A locally owned, full-service builder serving {site.serviceArea}.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- About Image Band -->
	<section class="bg-construction-dark">
		<div class="max-w-7xl mx-auto">
			<img
				src={placeholderImages.crew}
				alt="A&B Construction crew on a build in the Blue Ridge mountains"
				class="w-full h-[380px] md:h-[460px] object-cover"
				loading="lazy"
			/>
		</div>
	</section>

	<!-- Who We Are -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-start">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Who We Are</p>
						<h2 class="font-heading text-4xl md:text-5xl font-bold text-construction-dark mb-6">
							Built on communication and oversight
						</h2>
					</div>
				</FadeInSection>
				<FadeInSection client:load delay={0.15}>
					<div class="space-y-4 text-gray-700 text-lg">
						{aboutCopy.map((para) => (<p>{para}</p>))}
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- How We Operate -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">How We Operate</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Approach
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{operatingModel.map((item, index) => (
					<FadeInSection client:load delay={index * 0.05}>
						<div class="bg-construction-light p-8 border-l-4 border-construction-primary h-full">
							<h3 class="font-heading text-xl font-bold text-construction-dark mb-3">{item.title}</h3>
							{item.todo ? (
								<p class="text-construction-stone italic text-sm">Summary coming soon.</p>
							) : (
								<p class="text-gray-700 leading-relaxed">{item.body}</p>
							)}
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Leadership -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Our Team</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Partners
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{partners.map((member, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="overflow-hidden hover:shadow-xl transition-shadow">
							<div class="aspect-square bg-white flex items-center justify-center overflow-hidden">
								<span class="font-heading text-5xl font-bold text-construction-stone/40">{member.initials}</span>
							</div>
							<div class="p-6 bg-white border-t-4 border-construction-primary">
								<h3 class="font-heading text-2xl font-bold text-construction-dark uppercase tracking-wide mb-1">
									{member.name}
								</h3>
								<div class="text-construction-primary text-xs font-heading uppercase tracking-wider mb-4">
									{member.role}
								</div>
								{member.todo ? (
									<p class="text-construction-stone italic text-sm">Bio coming soon.</p>
								) : (
									<p class="text-gray-700">{member.bio}</p>
								)}
							</div>
						</div>
					</FadeInSection>
				))}
			</div>

			{officers.length > 0 && (
				<div class="mt-16">
					<FadeInSection client:load>
						<h2 class="font-heading text-4xl md:text-5xl font-bold text-construction-dark mb-8">
							Officers
						</h2>
					</FadeInSection>
					<div class="grid md:grid-cols-3 gap-8">
						{officers.map((member, index) => (
							<FadeInSection client:load delay={index * 0.1}>
								<div class="overflow-hidden hover:shadow-xl transition-shadow">
									<div class="aspect-square bg-white flex items-center justify-center overflow-hidden">
										<span class="font-heading text-5xl font-bold text-construction-stone/40">{member.initials}</span>
									</div>
									<div class="p-6 bg-white border-t-4 border-construction-primary">
										<h3 class="font-heading text-2xl font-bold text-construction-dark uppercase tracking-wide mb-1">
											{member.name}
										</h3>
										<div class="text-construction-primary text-xs font-heading uppercase tracking-wider mb-4">
											{member.role}
										</div>
										{member.todo ? (
											<p class="text-construction-stone italic text-sm">Bio coming soon.</p>
										) : (
											<p class="text-gray-700">{member.bio}</p>
										)}
									</div>
								</div>
							</FadeInSection>
						))}
					</div>
				</div>
			)}
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Let's Build Something Together
				</h2>
				<p class="text-xl text-white/60 mb-8">
					Residential or commercial — schedule a consultation with our team.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Get Started
					</a>
					<a
						href="/portfolio"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						See Our Work
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
