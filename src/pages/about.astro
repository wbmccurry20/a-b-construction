---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "About A&B Construction | Our Story";
const pageDescription = "Learn about A&B Construction's 20+ year history building custom homes and renovations in Western North Carolina. Meet our team and discover our values.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero (AC5) -->
	<section class="pt-32 pb-20 bg-construction-dark relative overflow-hidden">
		<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2 pointer-events-none"></div>
		<div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-white/[0.02] -rotate-12 translate-x-1/3 pointer-events-none"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">Our Story</p>
					<h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6">
						About A&B Construction
					</h1>
					<p class="text-xl text-white/60 max-w-xl">
						Building dreams and lasting relationships in Western North Carolina since 2004.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Our Story -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-start">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Since 2004</p>
						<h2 class="font-heading text-4xl md:text-5xl font-bold text-construction-dark mb-6">
							Our Story
						</h2>
						<div class="space-y-4 text-gray-700 text-lg">
							<p>
								A&B Construction was founded in 2004 by brothers Andrew and Benjamin Walker,
								who grew up in the mountains of Western North Carolina with a deep appreciation
								for quality craftsmanship and sustainable building practices.
							</p>
							<p>
								What started as a two-person operation building custom decks has grown into
								a full-service residential construction company with over 30 skilled craftsmen,
								designers, and project managers. Yet we've never lost sight of our core values:
								quality, integrity, and personal service.
							</p>
							<p>
								Over the past 20 years, we've completed more than 500 projects throughout
								Western North Carolina, from new custom homes to historic renovations.
								Each project is a testament to our commitment to excellence and our passion
								for creating spaces where families thrive.
							</p>
							<p>
								Today, we're proud to be one of the region's leading construction companies,
								known for our innovative approach, sustainable practices, and unwavering
								dedication to client satisfaction.
							</p>
						</div>
					</div>
				</FadeInSection>

				<!-- By the Numbers (AC6 — flat dark panel) -->
				<FadeInSection client:load delay={0.2}>
					<div class="bg-construction-dark p-12 text-white">
						<h3 class="font-heading text-3xl font-bold mb-8 uppercase tracking-wide">By the Numbers</h3>
						<div class="space-y-6">
							<div class="flex items-center border-b border-white/10 pb-6">
								<div class="font-heading text-5xl font-bold text-construction-accent mr-6">20+</div>
								<div>
									<div class="font-heading font-bold uppercase tracking-wide">Years in Business</div>
									<div class="text-white/50 text-sm">Established 2004</div>
								</div>
							</div>
							<div class="flex items-center border-b border-white/10 pb-6">
								<div class="font-heading text-5xl font-bold text-construction-accent mr-6">500+</div>
								<div>
									<div class="font-heading font-bold uppercase tracking-wide">Projects Completed</div>
									<div class="text-white/50 text-sm">And counting</div>
								</div>
							</div>
							<div class="flex items-center border-b border-white/10 pb-6">
								<div class="font-heading text-5xl font-bold text-construction-accent mr-6">30+</div>
								<div>
									<div class="font-heading font-bold uppercase tracking-wide">Team Members</div>
									<div class="text-white/50 text-sm">Skilled professionals</div>
								</div>
							</div>
							<div class="flex items-center">
								<div class="font-heading text-5xl font-bold text-construction-accent mr-6">98%</div>
								<div>
									<div class="font-heading font-bold uppercase tracking-wide">Client Satisfaction</div>
									<div class="text-white/50 text-sm">Proven track record</div>
								</div>
							</div>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Our Values (AC6 — border-t-4, no rounding) -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What Drives Us</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Core Values
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-3xl">
						These principles guide every decision we make and every project we undertake.
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						title: 'Quality First',
						description: 'We never compromise on quality. Every project receives our full attention to detail and commitment to excellence.',
					},
					{
						title: 'Integrity Always',
						description: 'Honest communication, transparent pricing, and ethical business practices are non-negotiable for us.',
					},
					{
						title: 'Sustainable Building',
						description: "We're committed to eco-friendly practices, energy-efficient designs, and reducing our environmental impact.",
					},
					{
						title: 'Client-Focused',
						description: 'Your vision, your budget, your timeline. We work for you and keep you involved every step of the way.',
					},
					{
						title: 'Innovation',
						description: 'We embrace modern technology and techniques while respecting traditional craftsmanship.',
					},
					{
						title: 'Community Impact',
						description: 'As locals, we care about our community and give back through volunteer work and local partnerships.',
					},
				].map((value, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-construction-primary hover:shadow-xl transition-shadow">
							<h3 class="font-heading text-2xl font-bold text-construction-dark mb-3">
								{value.title}
							</h3>
							<p class="text-gray-700">
								{value.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Team Section (AC6 — square headshot boxes, font-heading uppercase) -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Meet the Team</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Leadership
					</h2>
					<p class="text-xl text-gray-700 mt-4">
						The experienced team guiding A&B Construction's vision
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						name: 'Andrew Walker',
						initials: 'AW',
						role: 'Co-Founder & CEO',
						bio: '20+ years of construction experience. Specializes in sustainable building and project management.',
						credentials: 'Licensed General Contractor, LEED AP',
					},
					{
						name: 'Benjamin Walker',
						initials: 'BW',
						role: 'Co-Founder & COO',
						bio: 'Master craftsman with expertise in historic restoration and custom carpentry.',
						credentials: 'Licensed General Contractor, Master Carpenter',
					},
					{
						name: 'Sarah Martinez',
						initials: 'SM',
						role: 'Design Director',
						bio: 'Award-winning architect bringing innovative designs to life for 15 years.',
						credentials: 'Licensed Architect, AIA Member',
					},
				].map((member, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="overflow-hidden hover:shadow-xl transition-shadow">
							<div class="aspect-square bg-construction-light flex items-center justify-center overflow-hidden">
								<span class="font-heading text-5xl font-bold text-construction-stone/40">{member.initials}</span>
							</div>
							<div class="p-6 bg-white border-t-4 border-construction-primary">
								<h3 class="font-heading text-2xl font-bold text-construction-dark uppercase tracking-wide mb-1">
									{member.name}
								</h3>
								<div class="text-construction-primary text-xs font-heading uppercase tracking-wider mb-4">
									{member.role}
								</div>
								<p class="text-gray-700 mb-4">
									{member.bio}
								</p>
								<div class="text-sm text-gray-700 italic">
									{member.credentials}
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Certifications -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Trusted & Certified</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Certifications & Memberships
					</h2>
					<p class="text-xl text-gray-700 mt-4">
						Proud members of industry-leading organizations
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ name: 'NC Licensed General Contractor', abbr: 'NCLGC' },
					{ name: 'LEED Accredited Professional', abbr: 'LEED AP' },
					{ name: 'National Association of Home Builders', abbr: 'NAHB' },
					{ name: 'Better Business Bureau A+ Rating', abbr: 'BBB A+' },
				].map((cert, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white border-t-4 border-construction-primary/40 p-6 text-center hover:border-construction-primary hover:shadow-xl transition-all">
							<div class="font-heading text-4xl font-bold text-construction-primary mb-2">
								{cert.abbr}
							</div>
							<div class="text-sm text-gray-700 font-semibold">
								{cert.name}
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-construction-dark">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6">
					Let's Build Something Together
				</h2>
				<p class="text-xl text-white/60 mb-8">
					Experience the A&B Construction difference. Schedule your free consultation today.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Get Started
					</a>
					<a
						href="/portfolio"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						See Our Work
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
