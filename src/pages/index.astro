---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import QuoteCalculator from '../components/QuoteCalculator';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import QuickContact from '../components/QuickContact';
import Footer from '../components/Footer';

const pageTitle = "A&B Construction - Home Building in Western NC";
const pageDescription = "Residential construction and renovation in Western North Carolina. Custom homes, sustainable building, and expert craftsmanship for over 20 years.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero Section -->
	<section class="relative min-h-screen flex items-center overflow-hidden bg-construction-dark">
		<div class="absolute inset-0 overflow-hidden pointer-events-none">
			<div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
			<div class="absolute bottom-0 right-1/4 w-[800px] h-[800px] bg-white/[0.02] rotate-12 translate-y-1/3"></div>
		</div>
		<div class="absolute inset-0 opacity-5 pointer-events-none">
			<div class="absolute top-0 left-0 w-96 h-96 bg-construction-primary rounded-full filter blur-3xl"></div>
			<div class="absolute bottom-0 right-0 w-96 h-96 bg-construction-accent rounded-full filter blur-3xl"></div>
		</div>
		<div class="absolute inset-0">
			<img
				src="https://placehold.co/1920x1080/1C1F1A/1C1F1A"
				alt="A&B Construction — Western NC"
				class="w-full h-full object-cover object-center"
				loading="eager"
			/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-construction-dark via-construction-dark/85 to-construction-dark/30"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div>
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">
						Western North Carolina
					</p>
					<h1 class="font-heading text-7xl md:text-8xl lg:text-9xl font-bold text-white leading-none mb-8">
						Built Right.<br/>Built <span class="text-construction-accent">Local.</span>
					</h1>
					<p class="text-xl text-white/60 mb-10 max-w-md">
						Custom homes and renovations crafted with care in the mountains of Western NC.
					</p>
					<a
						href="/contact"
						class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading text-lg uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Start Your Project
						<svg class="ml-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>

				<div class="hidden lg:flex flex-col space-y-8 pl-12 border-l border-white/10">
					<div>
						<span class="font-heading text-5xl font-bold text-white">20+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Years in Business</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-bold text-white">500+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Projects Completed</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-bold text-construction-accent">98%</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Client Satisfaction</p>
					</div>
				</div>
			</div>
		</div>

		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
			<div class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center">
				<div class="w-1 h-3 bg-white/40 rounded-full mt-2 animate-bounce"></div>
			</div>
		</div>
	</section>

	<!-- Mobile Stats -->
	<section class="lg:hidden bg-construction-dark py-12 border-t border-white/10">
		<div class="max-w-7xl mx-auto px-4 grid grid-cols-3 gap-8 text-center">
			<div>
				<span class="font-heading text-4xl font-bold text-white">20+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Years</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-bold text-white">500+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Projects</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-bold text-construction-accent">98%</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Satisfied</p>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Why A&B</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Why Choose Us
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						step: '01',
						title: 'Modern Technology',
						description: '3D modeling, drone surveys, and smart home integration on every project.',
					},
					{
						step: '02',
						title: 'Sustainable Building',
						description: 'Eco-friendly materials, energy-efficient designs, and LEED certification.',
					},
					{
						step: '03',
						title: 'Expert Craftsmanship',
						description: 'Decades of experience building quality homes in the mountains.',
					},
				].map((feature, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-construction-primary hover:shadow-xl transition-shadow">
							<div class="text-3xl font-heading font-bold text-construction-primary/20 mb-4">{feature.step}</div>
							<h3 class="text-xl font-heading font-bold text-construction-dark mb-3">
								{feature.title}
							</h3>
							<p class="text-gray-700">
								{feature.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Before/After Showcase -->
	<section class="py-20 bg-construction-dark text-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">Transformations</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-white">
						Our Work
					</h2>
				</div>
			</FadeInSection>

			<FadeInSection client:load delay={0.2}>
				<p class="font-heading text-sm uppercase tracking-widest text-white/50 mb-4">Burnsville, NC — Kitchen Renovation</p>
				<BeforeAfterSlider
					client:load
					beforeImage="https://placehold.co/1200x800/cccccc/ffffff?text=Before+Renovation"
					afterImage="https://placehold.co/1200x800/2D6A4F/ffffff?text=After+Renovation"
					beforeAlt="Before renovation"
					afterAlt="After renovation"
				/>
			</FadeInSection>

			<div class="mt-12">
				<a
					href="/portfolio"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					View Full Portfolio
					<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Featured Projects -->
	<section class="py-20 bg-construction-dark border-t border-white/5">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">Our Portfolio</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-white">
						Featured Projects
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-6">
				{[
					{
						title: 'Modern Mountain Retreat',
						category: 'New Construction',
						image: 'https://placehold.co/800x600/2D6A4F/ffffff?text=Mountain+Home',
					},
					{
						title: 'Historic Craftsman Revival',
						category: 'Renovation',
						image: 'https://placehold.co/800x600/E9B84A/1C1F1A?text=Historic+Revival',
					},
					{
						title: 'Family Addition',
						category: 'Addition',
						image: 'https://placehold.co/800x600/74502A/ffffff?text=Family+Addition',
					},
				].map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a href="/portfolio" class="group block relative aspect-[4/3] overflow-hidden">
							<img
								src={project.image}
								alt={project.title}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-construction-dark/90 to-transparent"></div>
							<div class="absolute bottom-0 left-0 p-6">
								<p class="font-heading text-xs uppercase tracking-widest text-construction-accent mb-1">{project.category}</p>
								<h3 class="font-heading text-xl font-bold text-white">{project.title}</h3>
							</div>
						</a>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Get an Estimate -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Free Estimate</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Get an Estimate
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-2xl">
						Use our calculator or contact us directly for a free quote
					</p>
				</div>
			</FadeInSection>

			<div class="grid lg:grid-cols-5 gap-8 items-start">
				<div class="lg:col-span-3">
					<FadeInSection client:load delay={0.2}>
						<QuoteCalculator client:load />
					</FadeInSection>
				</div>
				<div class="lg:col-span-2">
					<FadeInSection client:load delay={0.3}>
						<QuickContact client:load />
					</FadeInSection>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Overview -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What We Do</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Services
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				{[
					{
						title: 'Custom Homes',
						description: 'Build your dream home from the ground up',
						link: '/services#new-construction',
					},
					{
						title: 'Renovations',
						description: 'Transform your existing space',
						link: '/services#renovations',
					},
					{
						title: 'Additions',
						description: 'Expand your living space seamlessly',
						link: '/services#additions',
					},
					{
						title: 'Remodeling',
						description: 'Kitchen, bath, and interior updates',
						link: '/services#remodeling',
					},
				].map((service, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a
							href={service.link}
							class="block p-6 bg-construction-light border-t-4 border-construction-primary hover:shadow-xl transition-shadow group"
						>
							<h3 class="text-xl font-heading font-bold mb-3 text-construction-dark group-hover:text-construction-primary transition-colors">
								{service.title}
							</h3>
							<p class="text-gray-700 mb-4 text-sm">
								{service.description}
							</p>
							<span class="text-construction-primary font-semibold inline-flex items-center text-sm">
								Learn more
								<svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</span>
						</a>
					</FadeInSection>
				))}
			</div>

			<div class="mt-12">
				<a
					href="/services"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					View All Services
				</a>
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What Clients Say</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Client Reviews
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						name: 'Sarah & Mike Johnson',
						project: 'Custom Home Build',
						quote: 'A&B Construction exceeded our expectations. Their use of technology kept us informed every step of the way, and the craftsmanship is outstanding.',
						rating: 5,
					},
					{
						name: 'David Martinez',
						project: 'Historic Renovation',
						quote: "They perfectly balanced preserving our home's character while adding modern conveniences. The project management portal was a game-changer.",
						rating: 5,
					},
					{
						name: 'Emily Chen',
						project: 'Green Building Consultation',
						quote: 'Their expertise in sustainable construction helped us achieve LEED certification. Professional, innovative, and dedicated to quality.',
						rating: 5,
					},
				].map((testimonial, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-construction-accent hover:shadow-xl transition-shadow">
							<div class="flex mb-4">
								{Array.from({ length: testimonial.rating }).map((_, i) => (
									<svg class="w-5 h-5 text-construction-accent fill-current" viewBox="0 0 24 24">
										<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
									</svg>
								))}
							</div>
							<p class="text-construction-dark mb-6 italic">
								"{testimonial.quote}"
							</p>
							<div class="border-t pt-4">
								<div class="font-heading font-bold text-construction-dark uppercase tracking-wide">
									{testimonial.name}
								</div>
								<div class="text-sm text-gray-700">
									{testimonial.project}
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Tagline Band -->
	<section class="py-24 bg-construction-dark text-center">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-7xl font-bold text-white leading-none mb-8">
					Your Home.<br/><span class="text-construction-accent">Done Right.</span>
				</h2>
				<a
					href="/contact"
					class="inline-flex items-center px-10 py-5 bg-construction-primary text-white font-heading text-xl uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Get Your Free Quote
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
