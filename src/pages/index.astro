---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import QuoteCalculator from '../components/QuoteCalculator';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import QuickContact from '../components/QuickContact';
import Footer from '../components/Footer';

const pageTitle = "A&B Construction | Custom Homes & Renovations in Burnsville, NC";
const pageDescription = "Custom homes and renovations in the Blue Ridge. A&B Construction builds and renovates residential homes in Burnsville and the surrounding mountains of Western North Carolina.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero Section -->
	<section class="relative min-h-screen flex items-center overflow-hidden bg-construction-dark">
		<svg
			class="absolute right-0 top-0 h-full w-auto opacity-[0.04] pointer-events-none"
			viewBox="0 0 400 600"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<ellipse cx="200" cy="300" rx="380" ry="260" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="320" ry="210" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="260" ry="165" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="200" ry="120" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="140" ry="80" stroke="white" stroke-width="1.5"/>
			<ellipse cx="200" cy="300" rx="80" ry="45" stroke="white" stroke-width="1.5"/>
		</svg>
		<div class="absolute inset-0 opacity-5 pointer-events-none">
			<div class="absolute top-0 left-0 w-96 h-96 bg-construction-primary rounded-full filter blur-3xl"></div>
			<div class="absolute bottom-0 right-0 w-96 h-96 bg-construction-accent rounded-full filter blur-3xl"></div>
		</div>
		<div class="absolute inset-0">
			<img
				src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80"
				alt="Custom mountain home built by A&B Construction in Western North Carolina"
				class="w-full h-full object-cover object-center"
				loading="eager"
			/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-construction-dark via-construction-dark/85 to-construction-dark/30"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div>
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">
						Burnsville, North Carolina
					</p>
					<h1 class="font-heading text-6xl md:text-7xl lg:text-8xl font-semibold text-white leading-[1.05] mb-8">
						Custom homes and<br/>renovations in the <span class="text-construction-accent italic">Blue Ridge.</span>
					</h1>
					<p class="text-xl text-white/70 mb-10 max-w-md">
						Residential construction for Burnsville and the surrounding mountains of Western North Carolina.
					</p>
					<a
						href="/contact"
						class="inline-flex items-center px-8 py-4 bg-construction-dark text-white font-heading text-lg tracking-wide hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
					>
						Start Your Project
						<svg class="ml-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>

				<div class="hidden lg:flex flex-col space-y-8 pl-12 border-l border-white/10">
					<div>
						<span class="font-heading text-5xl font-semibold text-white">20+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Years Building</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-semibold text-white">160+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Projects Completed</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-semibold text-construction-accent">4.9/5</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Client Satisfaction</p>
					</div>
				</div>
			</div>
		</div>

		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
			<div class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center">
				<div class="w-1 h-3 bg-white/40 rounded-full mt-2 animate-bounce"></div>
			</div>
		</div>
	</section>

	<!-- Mobile Stats -->
	<section class="lg:hidden bg-construction-dark py-12 border-t border-white/10">
		<div class="max-w-7xl mx-auto px-4 grid grid-cols-3 gap-8 text-center">
			<div>
				<span class="font-heading text-4xl font-semibold text-white">20+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Years</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-semibold text-white">160+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Projects</p>
			</div>
			<div>
				<span class="font-heading text-3xl font-semibold text-construction-accent">4.9/5</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Rated</p>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Why A&B</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Why Choose Us
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						step: '01',
						title: 'A Limited Number of Projects',
						description: "We take on a limited number of residential projects each year so detailing, schedule, and site conditions get real attention from start to finish.",
					},
					{
						step: '02',
						title: 'Built for the Mountains',
						description: "Mountain lots, existing foundations, and four-season weather are normal conditions for our crews — not exceptions. We plan for the terrain from day one.",
					},
					{
						step: '03',
						title: 'Clear from the Start',
						description: 'You get honest numbers before you sign, a single project manager through the build, and a 2-year workmanship warranty on completed work.',
					},
				].map((feature, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-construction-primary hover:shadow-xl transition-shadow">
							<div class="text-3xl font-heading font-bold text-construction-primary/20 mb-4">{feature.step}</div>
							<h3 class="text-xl font-heading font-bold text-construction-dark mb-3">
								{feature.title}
							</h3>
							<p class="text-gray-700">
								{feature.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Before/After Showcase -->
	<section class="py-20 bg-construction-dark text-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">Transformations</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-white">
						Our Work
					</h2>
				</div>
			</FadeInSection>

			<FadeInSection client:load delay={0.2}>
				<p class="font-heading text-sm uppercase tracking-widest text-white/50 mb-4">Spruce Pine, NC — Kitchen & Bath Renovation</p>
				<BeforeAfterSlider
					client:load
					beforeImage="https://images.unsplash.com/photo-1484154214963-1d0c076c6d0d?auto=format&fit=crop&w=1400&q=80"
					afterImage="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1400&q=80"
					beforeAlt="Dated 1970s kitchen before renovation by A&B Construction"
					afterAlt="Renovated kitchen with new cabinetry and finishes by A&B Construction"
				/>
			</FadeInSection>

			<div class="mt-12">
				<a
					href="/portfolio"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					View Full Portfolio
					<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Featured Projects -->
	<section class="py-20 bg-construction-dark border-t border-white/5">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">Our Portfolio</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-white">
						Featured Projects
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-6">
				{[
					{
						title: 'Cane River Residence',
						category: 'New Construction',
						image: 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1400&q=80',
					},
					{
						title: 'Town Center Craftsman',
						category: 'Renovation',
						image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=80',
					},
					{
						title: 'Bowlens Creek Addition',
						category: 'Addition',
						image: 'https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1400&q=80',
					},
				].map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a href="/portfolio" class="group block relative aspect-[4/3] overflow-hidden">
							<img
								src={project.image}
								alt={project.title}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-construction-dark/90 to-transparent"></div>
							<div class="absolute bottom-0 left-0 p-6">
								<p class="font-heading text-xs uppercase tracking-widest text-construction-accent mb-1">{project.category}</p>
								<h3 class="font-heading text-xl font-bold text-white">{project.title}</h3>
							</div>
						</a>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What Owners Say</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Trusted Across the Mountains
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-6">
				{[
					{
						quote: 'They treated a tight Burnsville lot like it mattered. Schedule held and the finish work is what we still notice.',
						attribution: 'The Callaway family',
						detail: 'Burnsville addition',
					},
					{
						quote: 'Our 1970s ranch needed a real plan, not a patch list. Kitchen, roof, and rear living room were done as one job.',
						attribution: 'J. Whitaker',
						detail: 'Spruce Pine renovation',
					},
					{
						quote: 'Clear numbers before we signed. No surprise extras on a steep site in Yancey County.',
						attribution: 'The Nguyen residence',
						detail: 'New home',
					},
				].map((testimonial, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<figure class="bg-white p-8 border-t-4 border-construction-accent h-full flex flex-col">
							<div class="text-construction-accent text-5xl font-heading leading-none mb-4" aria-hidden="true">&ldquo;</div>
							<blockquote class="text-construction-dark text-lg leading-relaxed flex-1">
								{testimonial.quote}
							</blockquote>
							<figcaption class="mt-6 pt-4 border-t border-construction-dark/10">
								<div class="font-heading font-bold text-construction-dark">{testimonial.attribution}</div>
								<div class="text-sm text-construction-stone uppercase tracking-wide">{testimonial.detail}</div>
							</figcaption>
						</figure>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Get an Estimate -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Planning Estimate</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Get an Estimate
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-2xl">
						Use the planning estimator for a ballpark, or contact us directly. Final numbers come after a site visit.
					</p>
				</div>
			</FadeInSection>

			<div class="grid lg:grid-cols-5 gap-8 items-start">
				<div class="lg:col-span-3">
					<FadeInSection client:load delay={0.2}>
						<QuoteCalculator client:load />
					</FadeInSection>
				</div>
				<div class="lg:col-span-2">
					<FadeInSection client:load delay={0.3}>
						<QuickContact client:load />
					</FadeInSection>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Overview -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What We Do</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Services
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				{[
					{
						title: 'Custom Homes',
						description: 'Build your dream home from the ground up',
						link: '/services#new-construction',
					},
					{
						title: 'Renovations',
						description: 'Transform your existing space',
						link: '/services#renovations',
					},
					{
						title: 'Additions',
						description: 'Expand your living space seamlessly',
						link: '/services#additions',
					},
					{
						title: 'Remodeling',
						description: 'Kitchen, bath, and interior updates',
						link: '/services#remodeling',
					},
				].map((service, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a
							href={service.link}
							class="block p-6 bg-construction-light border-t-4 border-construction-primary hover:shadow-xl transition-shadow group"
						>
							<h3 class="text-xl font-heading font-bold mb-3 text-construction-dark group-hover:text-construction-primary transition-colors">
								{service.title}
							</h3>
							<p class="text-gray-700 mb-4 text-sm">
								{service.description}
							</p>
							<span class="text-construction-primary font-semibold inline-flex items-center text-sm">
								Learn more
								<svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</span>
						</a>
					</FadeInSection>
				))}
			</div>

			<div class="mt-12">
				<a
					href="/services"
					class="inline-flex items-center px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					View All Services
				</a>
			</div>
		</div>
	</section>

	<!-- We Serve Western NC -->
	<section class="py-16 bg-construction-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div>
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">
						Proudly Local
					</p>
					<h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">
						We Serve Western NC
					</h2>
					<p class="text-white/70 text-lg max-w-lg">
						We're not a franchise. Every crew member lives in these mountains.
						We work where we know the land, the climate, and the community.
					</p>
				</div>
				<div class="grid grid-cols-3 gap-3">
					{[
						'Yancey County', 'Mitchell County', 'Avery County',
						'Madison County', 'Buncombe County', 'McDowell County',
						'Burke County', 'Watauga County', 'Caldwell County',
					].map((county) => (
						<div class="bg-white/10 px-3 py-3 text-center">
							<span class="font-heading text-xs uppercase tracking-wider text-white/80">
								{county}
							</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Trust section -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">A better build experience</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Clear from day one
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-2xl">The details change from home to home. The way we communicate should not.</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						number: '01',
						title: 'Straight answers',
						description: 'We explain what affects scope, cost, and schedule in plain language before work begins.',
					},
					{
						number: '02',
						title: 'One point of contact',
						description: 'A dedicated project manager stays reachable throughout the build, so questions never disappear into a handoff.',
					},
					{
						number: '03',
						title: 'Respect for the place',
						description: 'We plan around the land, the weather, and the way your home needs to work every day.',
					},
				].map((principle, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-construction-light p-8 border-l-4 border-construction-accent hover:shadow-xl transition-shadow">
							<div class="font-heading text-4xl font-bold text-construction-primary/30 leading-none mb-6">{principle.number}</div>
							<h3 class="font-heading text-2xl font-bold text-construction-dark mb-3">{principle.title}</h3>
							<p class="text-gray-700 leading-relaxed">{principle.description}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Tagline Band -->
	<section class="py-24 bg-construction-dark text-center">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-7xl font-bold text-white leading-none mb-8">
					Your Home.<br/>
					<span class="text-construction-accent">Your Mountains.</span>
				</h2>
				<p class="text-white/50 mt-4 text-xl max-w-xl mx-auto">
					Built by people who live here, with materials that belong here.
				</p>
				<a
					href="/contact"
					class="inline-flex items-center px-10 py-5 bg-construction-primary text-white font-heading text-xl uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Get Your Free Quote
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
