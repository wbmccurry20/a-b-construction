---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import QuoteCalculator from '../components/QuoteCalculator';
import QuickContact from '../components/QuickContact';
import Footer from '../components/Footer';
import {
	site,
	serviceCategories,
	operatingModel,
	projects,
	aboutCopy,
	placeholderImages,
} from '../data/site';

const pageTitle = "A&B Construction | Residential & Commercial Builders in Western NC";
const pageDescription = "A&B Construction is a full-service residential and commercial construction firm in Western North Carolina — custom homes, renovations, commercial builds, and specialty projects.";

const featuredProjects = projects.slice(0, 6);
const operatingHighlights = operatingModel.filter((item) => item.body);
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero: brand intro + Residential | Commercial split -->
	<section class="bg-construction-dark pt-32 pb-0">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl mb-10">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">
						{site.serviceArea}
					</p>
					<h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.05] mb-6">
						Residential &amp; commercial construction,<br class="hidden md:block" />
						<span class="text-construction-accent italic">built for the mountains.</span>
					</h1>
					<p class="text-xl text-white/70 max-w-2xl">
						{site.tagline} Choose your path below.
					</p>
				</div>
			</FadeInSection>
		</div>

		<!-- Split panels (MBI-style) -->
		<div class="grid md:grid-cols-2">
			{[
				{ label: 'Residential', href: '/residential', image: placeholderImages.residentialHero, blurb: 'Custom homes, renovations, additions & specialty builds.' },
				{ label: 'Commercial', href: '/commercial', image: placeholderImages.commercialHero, blurb: 'Light commercial, traveling builds & subcontracted work.' },
			].map((panel) => (
				<a
					href={panel.href}
					class="group relative block h-[420px] md:h-[560px] overflow-hidden"
					aria-label={`${panel.label} construction`}
				>
					<img
						src={panel.image}
						alt={`${panel.label} construction by ${site.name}`}
						class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
						loading="eager"
					/>
					<div class="absolute inset-0 bg-construction-dark/55 group-hover:bg-construction-dark/40 transition-colors"></div>
					<div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
						<h2 class="font-heading text-5xl md:text-6xl font-bold text-white drop-shadow-lg mb-3">
							{panel.label}
						</h2>
						<p class="text-white/85 max-w-xs mb-6">{panel.blurb}</p>
						<span class="inline-flex items-center px-6 py-3 border border-white/70 text-white font-heading uppercase tracking-[0.12em] text-xs group-hover:bg-construction-accent group-hover:text-construction-dark group-hover:border-construction-accent transition-all">
							Explore {panel.label}
							<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
							</svg>
						</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- About intro -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-start">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Who We Are</p>
						<h2 class="font-heading text-4xl md:text-5xl font-bold text-construction-dark mb-6">
							A locally owned, full-service builder
						</h2>
						<a href="/about" class="inline-flex items-center text-construction-primary font-heading uppercase tracking-wider text-sm hover:text-construction-accent transition-colors">
							More about A&B
							<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</div>
				</FadeInSection>
				<FadeInSection client:load delay={0.15}>
					<div class="space-y-4 text-gray-700 text-lg">
						{aboutCopy.map((para) => (<p>{para}</p>))}
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- What We Do -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">What We Do</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Our Services
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				{serviceCategories.map((service, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a
							href={`/${service.division}`}
							class="block h-full p-6 bg-construction-light border-t-4 border-construction-primary hover:shadow-xl transition-shadow group"
						>
							<p class="font-heading text-xs uppercase tracking-widest text-construction-stone mb-2">{service.division}</p>
							<h3 class="text-xl font-heading font-bold mb-3 text-construction-dark group-hover:text-construction-primary transition-colors">
								{service.title}
							</h3>
							<ul class="space-y-1.5 text-sm text-gray-700">
								{service.items.map((item) => (
									<li class="flex items-start">
										<span class="text-construction-primary mr-2">›</span>{item}
									</li>
								))}
							</ul>
						</a>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Projects -->
	<section class="py-20 bg-construction-dark border-t border-white/5">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">Our Portfolio</p>
						<h2 class="font-heading text-5xl md:text-6xl font-bold text-white">
							Featured Projects
						</h2>
					</div>
					<a href="/portfolio" class="inline-flex items-center text-construction-accent font-heading uppercase tracking-wider text-sm hover:text-white transition-colors">
						View full portfolio
						<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{featuredProjects.map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<a href="/portfolio" class="group block relative aspect-[4/3] overflow-hidden">
							<img
								src={project.image}
								alt={`${project.title} — ${project.location}`}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-construction-dark/90 to-transparent"></div>
							<div class="absolute bottom-0 left-0 p-6">
								<p class="font-heading text-xs uppercase tracking-widest text-construction-accent mb-1">{project.category}</p>
								<h3 class="font-heading text-xl font-bold text-white">{project.title}</h3>
								<p class="text-white/70 text-sm">{project.location}</p>
							</div>
						</a>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Featured build band -->
	<section class="relative overflow-hidden bg-construction-dark">
		<img
			src={placeholderImages.featureBand}
			alt="Custom craftsman home built by A&B Construction in the Blue Ridge mountains"
			class="w-full h-[420px] md:h-[560px] object-cover"
			loading="lazy"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-construction-dark via-construction-dark/30 to-transparent"></div>
		<div class="absolute bottom-0 left-0 right-0">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
				<FadeInSection client:load>
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-2">Custom Homes</p>
					<h2 class="font-heading text-4xl md:text-5xl font-bold text-white max-w-2xl">
						Craftsmanship that fits the mountains.
					</h2>
					<a href="/portfolio" class="inline-flex items-center mt-5 text-white font-heading uppercase tracking-wider text-sm hover:text-construction-accent transition-colors">
						See the work
						<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- How We Operate -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">How We Operate</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						A dependable way to build
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{operatingHighlights.map((item, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-l-4 border-construction-primary h-full shadow-md">
							<h3 class="font-heading text-xl font-bold text-construction-dark mb-3">{item.title}</h3>
							<p class="text-gray-700 leading-relaxed">{item.body}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Get an Estimate -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-construction-primary mb-3">Planning Estimate</p>
					<h2 class="font-heading text-5xl md:text-6xl font-bold text-construction-dark">
						Get an Estimate
					</h2>
					<p class="text-xl text-gray-700 mt-4 max-w-2xl">
						Use the planning estimator for a ballpark, or contact us directly. Final numbers come after a site visit.
					</p>
				</div>
			</FadeInSection>

			<div class="grid lg:grid-cols-5 gap-8 items-start">
				<div class="lg:col-span-3">
					<FadeInSection client:load delay={0.2}>
						<QuoteCalculator client:load />
					</FadeInSection>
				</div>
				<div class="lg:col-span-2">
					<FadeInSection client:load delay={0.3}>
						<QuickContact client:load />
					</FadeInSection>
				</div>
			</div>
		</div>
	</section>

	<!-- We Serve Western NC -->
	<section class="py-16 bg-construction-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div>
					<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-3">
						Proudly Local
					</p>
					<h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">
						We Serve Western NC
					</h2>
					<p class="text-white/70 text-lg max-w-lg">
						We're locally owned and work where we know the land, the climate, and the community —
						with travel capability for commercial clients beyond the region.
					</p>
				</div>
				<div class="grid grid-cols-3 gap-3">
					{[
						'Yancey County', 'Mitchell County', 'Avery County',
						'Madison County', 'Buncombe County', 'McDowell County',
						'Burke County', 'Watauga County', 'Caldwell County',
					].map((county) => (
						<div class="bg-white/10 px-3 py-3 text-center">
							<span class="font-heading text-xs uppercase tracking-wider text-white/80">
								{county}
							</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Band -->
	<section class="py-24 bg-construction-dark text-center">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-7xl font-bold text-white leading-none mb-8">
					Let's build<br/>
					<span class="text-construction-accent">something solid.</span>
				</h2>
				<p class="text-white/60 mt-4 text-xl max-w-xl mx-auto mb-10">
					Residential or commercial — tell us about your project and we'll take it from there.
				</p>
				<a
					href="/contact"
					class="inline-flex items-center px-10 py-5 bg-construction-primary text-white font-heading text-xl uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark hover:shadow-xl transition-all"
				>
					Get a Quote
				</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
