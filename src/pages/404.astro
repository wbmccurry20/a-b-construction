---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
---

<Layout title="Page Not Found | A&B Construction" description="This page doesn't exist.">
	<Navbar client:load />
	<section class="min-h-screen flex items-center bg-construction-dark">
		<div class="max-w-2xl mx-auto px-4 py-32 text-center">
			<p class="font-heading text-sm uppercase tracking-widest text-construction-accent mb-4">
				404
			</p>
			<h1 class="font-heading text-7xl font-bold text-white mb-6">
				Wrong Turn.
			</h1>
			<p class="text-white/60 text-xl mb-10">
				This page doesn't exist — but we're good at building things from scratch.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/"
					class="px-8 py-4 bg-construction-primary text-white font-heading uppercase tracking-wider hover:bg-construction-accent hover:text-construction-dark transition-all">
					Back to Home
				</a>
				<a href="/contact"
					class="px-8 py-4 border border-white/20 text-white font-heading uppercase tracking-wider hover:border-white/60 transition-all">
					Contact Us
				</a>
			</div>
		</div>
	</section>
	<Footer />
</Layout>
